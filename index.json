{
  "indexVersion": 1,
  "name": "Donald Mok's New API Plugins",
  "plugins": [
    {
      "key": "donaldxdonald_cloudflare-ai",
      "name": "Cloudflare AI",
      "icon": "text:CF",
      "description": {
        "en": "OpenAI-compatible chat with custom model names, FLUX images, MiniMax H3 videos and Clef typed decisions",
        "zh": "支持自定义模型名称的 OpenAI 兼容对话、FLUX 图片、MiniMax H3 视频和 Clef 结构化判断"
      },
      "routes": [
        {
          "method": "POST",
          "path": "/v1/systemone",
          "type": "submit",
          "decode": "decodeDecision",
          "render": "renderDecision",
          "retainResult": false,
          "models": [
            "@cf/cloudflare/clef",
            "@cf/cloudflare/clef-flash",
            "@cf/cloudflare/clef-omni"
          ]
        },
        {
          "method": "POST",
          "path": "/v1/decisions",
          "type": "submit",
          "decode": "decodeOpenAIDecisions",
          "render": "renderOpenAIDecisions",
          "retainResult": false,
          "models": [
            "@cf/cloudflare/clef",
            "@cf/cloudflare/clef-flash",
            "@cf/cloudflare/clef-omni"
          ]
        }
      ],
      "protocols": [
        {
          "name": "openai_image",
          "models": [
            "@cf/black-forest-labs/flux-1-schnell"
          ]
        },
        {
          "name": "openai_video",
          "models": [
            "minimax/h3"
          ]
        }
      ],
      "usageSchema": null,
      "usageExamples": null,
      "usageProfiles": [
        {
          "models": [
            "@cf/black-forest-labs/flux-1-schnell"
          ],
          "schema": {
            "image_count": {
              "type": "number",
              "unit": "count",
              "description": {
                "en": "Image generation unit price",
                "zh": "图片生成单价"
              }
            },
            "steps": {
              "type": "number",
              "unit": "count",
              "description": {
                "en": "Image generation step unit price",
                "zh": "图片生成步数单价"
              }
            }
          },
          "examples": [
            {
              "label": "1 image, 4 steps",
              "facts": {
                "image_count": 1,
                "steps": 4
              }
            }
          ]
        },
        {
          "models": [
            "minimax/h3"
          ],
          "schema": {
            "resolution": {
              "enum": [
                "768P",
                "2K"
              ],
              "description": {
                "en": "Output video resolution",
                "zh": "输出视频分辨率"
              }
            },
            "seconds": {
              "type": "number",
              "unit": "second",
              "description": {
                "en": "Video generation unit price",
                "zh": "视频生成单价"
              }
            }
          },
          "examples": [
            {
              "label": "5s, 768P",
              "facts": {
                "resolution": "768P",
                "seconds": 5
              }
            },
            {
              "label": "5s, 2K",
              "facts": {
                "resolution": "2K",
                "seconds": 5
              }
            }
          ]
        },
        {
          "models": [
            "@cf/cloudflare/clef",
            "@cf/cloudflare/clef-flash",
            "@cf/cloudflare/clef-omni"
          ],
          "schema": {
            "input_tokens": {
              "type": "number",
              "unit": "token",
              "description": {
                "en": "Input token unit price",
                "zh": "输入 token 单价"
              }
            }
          },
          "examples": [
            {
              "label": "1,000 input tokens",
              "facts": {
                "input_tokens": 1000
              }
            }
          ]
        }
      ],
      "models": [
        "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
        "@cf/zai-org/glm-4.7-flash",
        "@cf/black-forest-labs/flux-1-schnell",
        "minimax/h3",
        "@cf/cloudflare/clef",
        "@cf/cloudflare/clef-flash",
        "@cf/cloudflare/clef-omni"
      ],
      "task": true,
      "provider": true,
      "transform": false,
      "latest": "0.7.1",
